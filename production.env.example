# Copy outside source control and provide unique production secrets.
# compose.production.yaml derives APP_ORIGIN from SITE_DOMAIN and forces COOKIE_SECURE=true;
# compose.cloud.yaml instead requires APP_ORIGIN/WEB_PORT and defaults COOKIE_SECURE=false.
SITE_DOMAIN=todo.example.com
# Public origin used by compose.cloud.yaml (and CSRF/Origin checks). Include scheme and port.
APP_ORIGIN=http://todo.example.com:8080
# Host port compose.cloud.yaml publishes the web container on.
WEB_PORT=8080
# Set to true once real TLS terminates in front of (or inside) the web container.
COOKIE_SECURE=false
OWNER_DATABASE_PASSWORD=replace-owner-password
APP_DATABASE_PASSWORD=replace-app-password
DISCOVERY_DATABASE_PASSWORD=replace-discovery-password
# URL-encode special characters in DSN passwords.
DATABASE_URL=postgresql+psycopg://todo_app:replace-app-password@db:5432/todo
MIGRATION_DATABASE_URL=postgresql+psycopg://todo_owner:replace-owner-password@db:5432/todo
WORKER_DISCOVERY_DATABASE_URL=postgresql+psycopg://todo_discovery:replace-discovery-password@db:5432/todo
CREDENTIAL_MASTER_KEY=replace-with-generated-fernet-key
SYSTEM_EMBEDDING_MODEL=qwen3.7-text-embedding
SYSTEM_EMBEDDING_REGION=cn
SYSTEM_EMBEDDING_DIMENSIONS=1024
SYSTEM_EMBEDDING_API_KEY=replace-with-operator-bailian-key
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=todo@example.com
SMTP_USERNAME=todo@example.com
SMTP_PASSWORD=replace-smtp-password
SMTP_STARTTLS=true
# Free feeds + keyless Exa MCP. Rate/network limits fall back to feeds.
NEWS_SEARCH_PROVIDER=free
# Optional paid provider: enable bocha only after reviewing its billing.
BOCHA_SEARCH_API_KEY=
# Alternatively store the key privately in the runtime volume.
BOCHA_SEARCH_KEY_FILE=
