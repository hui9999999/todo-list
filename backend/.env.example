DATABASE_URL=postgresql+psycopg://todo_app:todo_app_local@127.0.0.1:25432/todo
MIGRATION_DATABASE_URL=postgresql+psycopg://todo_owner:todo_owner_local@127.0.0.1:25432/todo
APP_ORIGIN=http://localhost:5174
COOKIE_SECURE=false
SMTP_HOST=127.0.0.1
SMTP_PORT=21025
SMTP_FROM=todo@localhost.test
# Production: HTTPS origin, COOKIE_SECURE=true, real SMTP with TLS and credentials.
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Required in production, or use the locally generated .runtime/credential.key.
CREDENTIAL_MASTER_KEY=
CREDENTIAL_KEY_FILE=.runtime/credential.key
ARTICLE_SOURCES_FILE=article-sources.json
# Operator-managed history search, independent of users' chat connections.
SYSTEM_EMBEDDING_MODEL=qwen3.7-text-embedding
SYSTEM_EMBEDDING_REGION=cn
SYSTEM_EMBEDDING_DIMENSIONS=1024
SYSTEM_EMBEDDING_API_KEY=
# Encrypted with the application's Fernet credential master key.
SYSTEM_EMBEDDING_KEY_FILE=.runtime/system-embedding.key
